# Story text, scene images (openai/gpt-image-2) and scene BGM (google/lyria-3-clip-preview).
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Character embeddings for RAG only.
HF_TOKEN=your_huggingface_token_here
SUPABASE_URL=your_supabase_url_here
# Server-only key that bypasses RLS: a secret key (sb_secret_...) from Settings > API Keys.
# The legacy service_role key also works until Supabase retires it (end of 2026).
# Never the anon or publishable key: the server tables (story_plans, story_beats, ...) have no
# client policies, and the database functions run only for service_role.
SUPABASE_KEY=your_supabase_secret_key_here
# Skeleton-mode stories (planned story with choices). Off unless set to 1.
SKELETON_MODE_ENABLED=0

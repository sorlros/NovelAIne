\f0\fs24 \cf0 2026\uc0\u45380  \u51064 \u44277 \u51648 \u45733  \u44592 \u48152  \u49548 \u49444  \u52285 \u51089  \u49373 \u53468 \u44228  \u48143  \u45824 \u54805  \u50616 \u50612  \u47784 \u45944 (LLM) \u54876 \u50857  \u46041 \u54693  \u49900 \u52789  \u48516 \u49437  \u48372 \u44256 \u49436 1. \u49436 \u47200 : \u47928 \u54617  \u52285 \u51089 \u51032  \u44396 \u51312 \u51201  \u51204 \u54872 \u44284  \u51064 \u44277 \u51648 \u45733  \u49373 \u53468 \u44228 \u51032  \u51116 \u54200 2026\u45380  \u54788 \u51116 , \u45824 \u54805  \u50616 \u50612  \u47784 \u45944 (Large Language Models, LLMs)\u51008  \u45800 \u49692 \u54620  \u47928 \u51109  \u44368 \u51221  \u48372 \u51312  \u46020 \u44396 \u47484  \u45336 \u50612  \u44592 \u54925 , \u49464 \u44228 \u44288  \u44396 \u52629 , \u49436 \u49324  \u51204 \u44060 , \u44368 \u51221  \u48143  \u52636 \u54032  \u48264 \u50669 \u50640  \u51060 \u47476 \u45716  \u49548 \u49444  \u52285 \u51089 \u51032  \u51204  \u44284 \u51221 \u51012  \u51452 \u46020 \u54616 \u45716  \u54645 \u49900  \u50500 \u53412 \u53581 \u52376 \u47196  \u50756 \u51204 \u55176  \u51088 \u47532  \u51105 \u50520 \u45796 . \u50937 \u49548 \u49444  \u49884 \u51109 \u51012  \u51473 \u49900 \u51004 \u47196  \u54616 \u47336  1\u47564  \u51088  \u51665 \u54596 \u51060  \u51064 \u44036  \u51089 \u44032 \u51032  \u47932 \u47532 \u51201  \u54620 \u44228 \u51060 \u51088  \u46021 \u48372 \u51201 \u51064  \u50669 \u47049 \u51004 \u47196  \u48520 \u47532 \u45912  \u44284 \u44144 \u50752  \u45804 \u47532 , \u51064 \u44277 \u51648 \u45733 \u51012  \u54876 \u50857 \u54616 \u50668  \u45800  48\u49884 \u44036  \u45236 \u50640  500\u47564  \u51088 \u51032  \u53581 \u49828 \u53944 \u47484  \u49373 \u49457 \u54644 \u45236 \u45716  \u51060 \u47480 \u48148  '\u49373 \u49328 \u49457  \u45796 \u50868 \u44536 \u47112 \u51060 \u46300  \u44277 \u44201 (Downgrading Attack)' \u54788 \u49345 \u51060  \u51452 \u50836  \u50937 \u49548 \u49444  \u54540 \u47019 \u54268 \u51032  \u45936 \u51060 \u53552 \u47196  \u51649 \u51217  \u54869 \u51064 \u46104 \u44256  \u51080 \u45796 . \u51060 \u47084 \u54620  \u50517 \u46020 \u51201 \u51064  \u53581 \u49828 \u53944  \u47932 \u47049  \u44277 \u49464  \u49549 \u50640 \u49436  \u47928 \u54617  \u52964 \u48036 \u45768 \u54000  \u45236 \u48512 \u50640 \u49436 \u45716  \u44592 \u49696 \u50640  \u45824 \u54620  \u49688 \u50857 \u44284  \u44144 \u48512 \u51032  \u50577 \u44537 \u54868  \u54788 \u49345 \u51060  \u48156 \u49373 \u54616 \u50688 \u45796 . \u51068 \u47168 \u47196  \u50976 \u47749  \u47928 \u54617  \u47588 \u52404 \u51064  Lit Hub\u50640 \u49436 \u45716  \u51089 \u44032 \u46308 \u51060  AI \u51089 \u54408  \u52636 \u54032 \u51012  \u44277 \u44060 \u51201 \u51004 \u47196  \u44508 \u53444 \u54616 \u45716  \u49436 \u54620 \u51012  \u48156 \u54364 \u54616 \u50688 \u51004 \u47728 , n+1 \u47588 \u44144 \u51652 \u51008  AI\u47484  "\u50557 \u54616 \u44256  \u54200 \u54801 \u54616 \u47728  \u51312 \u50501 \u54620  \u44592 \u44228 "\u47196  \u47749 \u47749 \u54616 \u45716  \u46321  \u44201 \u47148 \u54620  \u48152 \u48156 \u51060  \u51068 \u44592 \u46020  \u54664 \u45796 . \u44536 \u47084 \u45208  \u44208 \u44284 \u51201 \u51004 \u47196  \u51064 \u44277 \u51648 \u45733 \u51032  \u51316 \u51116 \u45716  \u47928 \u54617 \u51060  \u52285 \u51089 \u46104 \u44256  \u49548 \u48708 \u46104 \u45716  \u48169 \u49885 \u51012  \u48520 \u44032 \u50669 \u51201 \u51004 \u47196  \u48320 \u54868 \u49884 \u53040 \u45796 .\u52488 \u44592  \u50616 \u50612  \u47784 \u45944 \u46308 \u51060  \u45824 \u47749 \u49324 \u47484  \u54844 \u46041 \u54616 \u44144 \u45208 , \u50864 \u47532 \u44032  \u47112 \u47788 \u51012  \u49324 \u44284 \u52376 \u47100  \u47673 \u45716 \u45796 \u44256  \u52265 \u44033 \u54616 \u44144 \u45208 , \u54588 \u52852 \u49548 \u44032  \u45224 \u44537 \u51032  \u50773 \u51060 \u46972 \u44256  \u44403 \u44172  \u48127 \u50632 \u45912  \u49884 \u51208 \u50640  \u45824 \u54620  \u51068 \u47568 \u51032  \u54693 \u49688 \u45716  \u51060 \u51228  \u50756 \u51204 \u55176  \u49324 \u46972 \u51276 \u45796 . 2026\u45380 \u51032  AI \u47784 \u45944 \u46308 \u51008  \u51648 \u52824 \u51648  \u50506 \u45716  \u52509 \u44292  \u48708 \u49436 \u51060 \u51088  \u44053 \u47141 \u54620  \u50640 \u51060 \u51204 \u53944 \u47196  \u51652 \u54868 \u54664 \u45796 . \u53945 \u55176  2026\u45380 \u51032  \u50629 \u47924  \u54056 \u47084 \u45796 \u51076 \u51008  \u45800 \u49692 \u55176  \u52292 \u54021 \u52285  \u50504 \u50640 \u49436  \u47568 \u47196  \u45824 \u54868 \u54616 \u45716  \u45800 \u44228 \u47484  \u45336 \u50612 , AI\u44032  \u51649 \u51217  \u47928 \u49436  \u51089 \u50629 \u51012  \u49688 \u54665 \u54616 \u44256  \u51089 \u44032 \u45716  \u44536  \u44208 \u44284 \u50752  \u48169 \u54693 \u49457 \u47564 \u51012  \u54869 \u51064 \u54616 \u45716  '\u50640 \u51060 \u51204 \u53944  \u44592 \u48152 \u51032  \u54801 \u50629 (Cowork)' \u44396 \u51312 \u47196  \u44256 \u46020 \u54868 \u46104 \u50632 \u45796 .\u54788 \u45824  \u52285 \u51089 \u51088 \u46308 \u51008  \u45800 \u51068  \u52311 \u48391 \u50640  \u51032 \u51316 \u54616 \u45716  \u50896 \u49884 \u51201 \u51064  \u45800 \u44228 \u47484  \u48279 \u50612 \u45228 \u45796 . 2026\u45380 \u51032  \u49548 \u49444  \u52285 \u51089  \u49373 \u53468 \u44228 \u45716  \u48276 \u50857 \u51201 \u51004 \u47196  \u44032 \u51109  \u46832 \u50612 \u45212  \u52628 \u47200  \u48143  \u49328 \u47928  \u49373 \u49457  \u45733 \u47141 \u51012  \u44054 \u52632  '\u48276 \u50857  \u45824 \u54805  \u50616 \u50612  \u47784 \u45944 (General-Purpose LLMs)'\u44284 , \u49548 \u49444 \u44032 \u46308 \u51032  \u44256 \u50976 \u54620  \u51089 \u50629  \u55120 \u47492 (Workflow) \u48143  \u48169 \u45824 \u54620  \u49464 \u44228 \u44288  \u44288 \u47532 \u50640  \u52572 \u51201 \u54868 \u46108  '\u49548 \u49444  \u52285 \u51089  \u53945 \u54868  \u54540 \u47019 \u54268 (Specialized Novel Writing Platforms)'\u51004 \u47196  \u51060 \u50896 \u54868 \u46104 \u50612  \u48156 \u51204 \u54616 \u44256  \u51080 \u45796 . \u48376  \u48372 \u44256 \u49436 \u45716  2026\u45380  \u44592 \u51456  \u51204  \u49464 \u44228  \u48143  \u54620 \u44397  \u49884 \u51109 \u50640 \u49436  \u44032 \u51109  \u45328 \u47532  \u49324 \u50857 \u46104 \u45716  \u48276 \u50857  LLM\u51032  \u47928 \u54617 \u51201  \u49457 \u45733 \u51012  \u49900 \u52789 \u51201 \u51004 \u47196  \u48516 \u49437 \u54616 \u44256 , \u52285 \u51089 \u51088 \u46308 \u51032  \u49373 \u49328 \u49457 \u51012  \u44537 \u45824 \u54868 \u54616 \u45716  \u49548 \u49444  \u53945 \u54868  \u47784 \u45944  \u48143  \u54540 \u47019 \u54268 \u51032  \u44396 \u51312 \u51201  \u53945 \u49457 \u44284  \u54876 \u50857  \u53944 \u47116 \u46300 \u47484  \u51333 \u54633 \u51201 \u51004 \u47196  \u44508 \u47749 \u54616 \u50668  \u51204 \u47928 \u44032 \u46308 \u51012  \u50948 \u54620  \u44144 \u49884 \u51201  \u53685 \u52272 \u51012  \u51228 \u44277 \u54620 \u45796 .2. \u48276 \u50857  \u45824 \u54805  \u50616 \u50612  \u47784 \u45944 (General-Purpose LLMs)\u51032  \u49548 \u49444  \u52285 \u51089  \u54876 \u50857  \u48516 \u49437 2025\u45380  \u47568 \u48512 \u53552  2026\u45380  \u52488 \u44620 \u51648  \u51060 \u50612 \u51652  \u44544 \u47196 \u48268  \u48709 \u53580 \u53356  \u44592 \u50629 \u46308 \u51032  \u54540 \u47000 \u44536 \u49901  AI \u47784 \u45944  \u45824 \u44508 \u47784  \u50629 \u45936 \u51060 \u53944 \u45716  \u47928 \u54617  \u52285 \u51089 \u51032  \u51656 \u51201  \u46020 \u50557 \u51012  \u51060 \u45132 \u50632 \u45796 . \u54788 \u51116  \u52285 \u51089 \u51088 \u46308 \u51060  \u44032 \u51109  \u49440 \u54840 \u54616 \u45716  \u48276 \u50857  \u47784 \u45944 \u46308 \u51008  \u44033 \u44592  \u45796 \u47480  \u50500 \u53412 \u53581 \u52376 \u50752  \u53945 \u54868 \u46108  \u51109 \u51216 \u51012  \u48148 \u53461 \u51004 \u47196  \u52285 \u51089  \u54028 \u51060 \u54532 \u46972 \u51064 \u51032  \u49345 \u51060 \u54620  \u45800 \u44228 \u47484  \u45812 \u45817 \u54616 \u44256  \u51080 \u45796 .2.1. Claude 4.5 (Anthropic): \u49900 \u52789 \u51201  \u49328 \u47928  \u49373 \u49457 \u44284  \u47928 \u54617 \u51201  \u54364 \u54788 \u51032  \u54364 \u51456 \u49548 \u49444  \u51089 \u44032 \u46308  \u49324 \u51060 \u50640 \u49436  \u50517 \u46020 \u51201 \u51064  1\u50948 \u47196  \u54217 \u44032 \u48155 \u45716  \u48276 \u50857  \u47784 \u45944 \u51008  Anthropic\u51032  Claude \u49884 \u47532 \u51592 , \u53945 \u55176  \u52572 \u49888  \u48260 \u51204 \u51064  Claude 4.5 Sonnet \u48143  Opus\u51060 \u45796 . \u44592 \u48376  200,000 \u53664 \u53360 \u50640 \u49436  \u48288 \u53440  \u53580 \u49828 \u53944  \u44592 \u51456  \u52572 \u45824  100\u47564  \u53664 \u53360 \u50640  \u45804 \u54616 \u45716  \u48169 \u45824 \u54620  \u52968 \u53581 \u49828 \u53944  \u50952 \u46020 \u50864 \u47484  \u51648 \u50896 \u54616 \u45716  Claude 4.5\u45716  \u49828 \u53356 \u47549 \u53944  \u51204 \u52404 \u45208  \u49688 \u49901  \u54168 \u51060 \u51648 \u50640  \u45804 \u54616 \u45716  \u44596  \u52309 \u53552 \u47484  \u47700 \u47784 \u47532 \u50640  \u50504 \u51221 \u51201 \u51004 \u47196  \u50976 \u51648 \u54616 \u47728 , \u48373 \u51105 \u54620  \u45796 \u51473  \u51648 \u49884 \u49324 \u54637 \u51012  \u46384 \u47476 \u45716  \u45936  \u53441 \u50900 \u54620  \u49457 \u45733 \u51012  \u48156 \u55064 \u54620 \u45796 .Claude 4.5\u44032  \u47928 \u54617 \u44228 \u50640 \u49436  \u44032 \u51109  \u44033 \u44305 \u48155 \u45716  \u44540 \u48376 \u51201 \u51064  \u51060 \u50976 \u45716  \u53945 \u50976 \u51032  '\u49328 \u47928 (Prose) \u54408 \u51656 '\u50640  \u51080 \u45796 . \u53440  \u47784 \u45944 \u46308 \u51060  \u51333 \u51333  \u44592 \u44228 \u51201 \u51064  \u45656 \u50521 \u49828 \u47484  \u54413 \u44592 \u44144 \u45208  \u51648 \u45208 \u52824 \u44172  \u54868 \u47140 \u54616 \u44256  \u51089 \u50948 \u51201 \u51064  \u48120 \u49324 \u50668 \u44396 (Purple Prose)\u50640  \u52824 \u50864 \u52432  \u54980 \u49549  \u54200 \u51665 \u51012  \u50612 \u47157 \u44172  \u47564 \u46300 \u45716  \u48152 \u47732 , Claude\u45716  \u49892 \u51228  \u51089 \u44032 \u46308 \u51060  \u49324 \u50857 \u54616 \u45716  \u44163 \u44284  \u44057 \u51008  \u54840 \u55137 \u51032  \u45800 \u46973 (Paragraphs)\u51012  \u49373 \u49457 \u54616 \u44256  \u51089 \u44032 \u51032  \u44256 \u50976 \u54620  \u47785 \u49548 \u47532 \u47484  \u47784 \u48169 \u54616 \u45716  \u45936  \u51080 \u50612  \u54788 \u51316 \u54616 \u45716  AI \u51473  \u52572 \u44256 \u51032  \u49457 \u45733 \u51012  \u48372 \u50668 \u51456 \u45796 . \u51089 \u44032 \u46308 \u51008  Claude\u51032  '\u54532 \u47196 \u51229 \u53944 (Project)' \u44592 \u45733 \u51012  \u51201 \u44537  \u54876 \u50857 \u54616 \u50668  \u49464 \u44228 \u44288  \u48148 \u51060 \u48660 , \u52880 \u47533 \u53552  \u49884 \u53944 , \u44060 \u50836  \u46321 \u51012  \u48120 \u47532  \u50629 \u47196 \u46300 \u54644  \u46160 \u44256 , \u49328 \u47564 \u54632  \u50630 \u45716  \u48120 \u45768 \u47680 \u47532 \u49828 \u53944  \u54872 \u44221 \u50640 \u49436  \u44618 \u51060  \u51080 \u45716  \u45236 \u47732  \u47896 \u49324 \u50752  \u48120 \u47896 \u54620  \u52880 \u47533 \u53552  \u50500 \u53356 (Character Arc)\u47484  \u51204 \u44060 \u54616 \u45716  \u49900 \u52789  \u51089 \u50629 (Deep Work)\u51012  \u49688 \u54665 \u54620 \u45796 . \u44592 \u49696  \u48292 \u52824 \u47560 \u53356  \u49345 \u51004 \u47196 \u45716  \u53076 \u46377  \u53580 \u49828 \u53944 \u51064  SWE-bench Verified\u50640 \u49436  80.9%\u47484  \u44592 \u47197 \u54616 \u47728  \u50517 \u46020 \u51201 \u51064  \u49457 \u45733 \u51012  \u48372 \u50688 \u51004 \u45208 , \u52285 \u51089 \u51088 \u46308 \u50640 \u44172 \u45716  \u51060 \u47084 \u54620  \u45436 \u47532 \u47141 \u51060  \u48373 \u51105 \u54620  \u49436 \u49324  \u44396 \u51312 \u47484  \u51075 \u51648  \u50506 \u44256  \u45656 \u50521 \u49828 \u44032  \u54413 \u48512 \u54620  \u49548 \u49444 \u51060 \u45208  \u48652 \u47004 \u46300  \u49828 \u53664 \u47532 \u47484  \u52488 \u50504 \u54616 \u45716  \u45936  \u47588 \u50864  \u51201 \u54633 \u54616 \u44172  \u51089 \u50857 \u54616 \u44256  \u51080 \u45796 . \u53685 \u51228 \u46108  \u54588 \u46300 \u48177 \u44284  \u51221 \u48128 \u54620  \u53668  \u51312 \u51208 \u51060  \u54596 \u50836 \u54620  \u44368 \u51221  \u45800 \u44228 \u50640 \u49436 \u45716  \u51060 \u51204  \u47784 \u45944 \u51064  Claude 3.7 Sonnet \u50669 \u49884  \u50668 \u51204 \u55176  \u45328 \u47532  \u54876 \u50857 \u46104 \u44256  \u51080 \u45796 .2.2. GPT-5.2 (OpenAI): \u49464 \u44228 \u44288  \u44396 \u52629  \u48143  \u45436 \u47532 \u51201  \u50500 \u53412 \u53581 \u52376 \u51032  \u51208 \u45824 \u51201  \u49444 \u44228 \u51088 OpenAI\u44032  2025\u45380  12\u50900  19\u51068 \u50640  \u51204 \u44201  \u52636 \u49884 \u54620  GPT-5.2\u45716  128,000 \u53664 \u53360 \u51032  \u52968 \u53581 \u49828 \u53944  \u50952 \u46020 \u50864 \u50752  \u49328 \u50629 \u44228  \u52572 \u44256  \u49688 \u51456 \u51032  \u50640 \u51060 \u51204 \u53944 (Agentic) \u45733 \u47141 \u51012  \u51088 \u46993 \u54616 \u45716  \u51648 \u49885  \u45432 \u46041  \u48143  \u52285 \u51089  \u44592 \u54925 \u51032  \u54645 \u49900  \u47784 \u45944 \u51060 \u45796 . \u51060  \u47784 \u45944 \u51008  \u44048 \u49457 \u51201 \u51064  \u47928 \u54617  \u49328 \u47928  \u49373 \u49457  \u44536  \u51088 \u52404 \u50640 \u49436 \u45716  Claude 4.5\u50640 \u44172  \u45796 \u49548  \u48128 \u47536 \u45796 \u45716  \u54217 \u44032 \u47484  \u48155 \u44592 \u46020  \u54616 \u51648 \u47564 , \u49548 \u49444 \u51032  \u48904 \u45824 \u47484  \u49464 \u50864 \u45716  '\u45436 \u47532 \u51201  \u50500 \u53412 \u53581 \u52376  \u49444 \u44228 ' \u50689 \u50669 \u50640 \u49436 \u45716  \u53440 \u51032  \u52628 \u51333 \u51012  \u48520 \u54728 \u54620 \u45796 .\u53945 \u55176  GPT-5.2\u50640  \u45236 \u51109 \u46108  \u44053 \u47141 \u54620  '\u52628 \u47200  \u47784 \u46300 (Thinking Mode)'\u45716  \u48373 \u51105 \u54616 \u44172  \u50621 \u55180  \u54540 \u47215 \u51032  \u54728 \u51216 \u51012  \u52286 \u50500 \u45236 \u45716  '\u47112 \u46300 \u54016 (Red Team)' \u50669 \u54624 \u51060 \u45208 , \u45824 \u54616 \u49548 \u49444  \u49688 \u51456 \u51032  \u48373 \u51105 \u54620  \u51064 \u47932  \u44288 \u44228 \u46020  \u48143  \u51109 \u54200  \u49548 \u49444 \u51032  \u49444 \u51221  \u52649 \u46028 \u51012  \u44160 \u51613 \u54616 \u45716  \u45936  \u52572 \u51201 \u54868 \u46104 \u50612  \u51080 \u45796 . \u52488 \u44592  \u50500 \u51060 \u45936 \u51060 \u49496 , \u50500 \u50883 \u46972 \u51064  \u51089 \u49457 , \u49464 \u44228 \u44288 \u51032  \u47932 \u47532 \u51201  \u48277 \u52825 \u51060 \u45208  \u47560 \u48277  \u52404 \u44228 \u51032  \u45436 \u47532 \u49457 \u51012  \u50628 \u48128 \u54616 \u44172  \u44396 \u52629 \u54616 \u45716  \u45936  \u51080 \u50612  \u50517 \u46020 \u51201 \u51064  \u51648 \u45733 \u51012  \u48372 \u51060 \u47728 , \u51204 \u47928  \u51648 \u49885  \u45432 \u46041  \u53580 \u49828 \u53944 \u50640 \u49436  \u51064 \u44036  \u51204 \u47928 \u44032 \u47484  70.9%\u51032  \u54869 \u47456 \u47196  \u45733 \u44032 \u54616 \u44144 \u45208  \u46041 \u47456 \u51012  \u51060 \u47336 \u45716  \u44592 \u50684 \u51012  \u53664 \u54664 \u45796 . \u45796 \u47564 , \u48708 \u50857  \u54952 \u50984 \u49457  \u52769 \u47732 \u50640 \u49436 \u45716  \u51452 \u51032 \u44032  \u54596 \u50836 \u54616 \u45796 . GPT-5.2\u45716  \u51060 \u51204  \u47784 \u45944 \u51064  GPT-5.1\u50640  \u48708 \u54644  6\u48176  \u51060 \u49345  \u47566 \u51008  \u53664 \u53360 \u51012  \u49548 \u47784 \u54616 \u47728  \u44032 \u44201  \u51221 \u52293  \u46608 \u54620  \u49345 \u49849 \u54616 \u50668  \u48292 \u52824 \u47560 \u53356  \u44396 \u46041  \u49884  \u49345 \u45817 \u54620  \u48708 \u50857 \u51060  \u52397 \u44396 \u46104 \u45716  \u44163 \u51004 \u47196  \u45208 \u53440 \u45228 \u45796 . \u51060 \u47196  \u51064 \u54644  \u51089 \u44032 \u46308 \u51008  \u44256 \u52264 \u50896 \u51201 \u51064  \u545